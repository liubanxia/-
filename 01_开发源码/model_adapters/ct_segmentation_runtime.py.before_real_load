from pathlib import Path


class CT3DSegmentationAdapter:

    def __init__(self, model_id, root, task):
        self.model_id = model_id
        self.root = Path(root)
        self.task = task

        self.checkpoint = None
        self.config = None
        self.model = None

        self.status = "ADAPTER_READY_UNTESTED"

    def discover_assets(self):
        if not self.root.exists():
            raise FileNotFoundError(self.root)

        weights = []
        for ext in ("*.pt", "*.pth", "*.ckpt"):
            weights += list(self.root.rglob(ext))

        configs = []
        for ext in ("*.json", "*.yaml", "*.yml"):
            configs += list(self.root.rglob(ext))

        if weights:
            weights.sort(
                key=lambda p: p.stat().st_size,
                reverse=True,
            )
            self.checkpoint = weights[0]

        if configs:
            self.config = configs[0]

        return {
            "model_id": self.model_id,
            "root": str(self.root),
            "checkpoint": (
                str(self.checkpoint)
                if self.checkpoint else None
            ),
            "config": (
                str(self.config)
                if self.config else None
            ),
            "status": self.status,
        }

    def load(self, device="cpu"):
        """
        Actual framework construction is delayed until
        unified debugging. Asset paths are already real.
        """
        self.discover_assets()

        if self.checkpoint is None:
            raise RuntimeError(
                f"{self.model_id}: checkpoint not found"
            )

        self.status = "ASSETS_READY_UNTESTED"
        return self

    def run(self, volume):
        raise RuntimeError(
            f"{self.model_id}: forward reserved "
            "for unified debugging"
        )

    def unload(self):
        self.model = None
        self.status = "ADAPTER_READY_UNTESTED"


