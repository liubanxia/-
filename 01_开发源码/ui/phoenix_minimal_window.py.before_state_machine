from __future__ import annotations

import os

from PySide6.QtCore import QThread, Signal
from PySide6.QtWidgets import (
    QMainWindow,
    QWidget,
    QVBoxLayout,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QMessageBox,
)

from output.ai_report_window import AIReportWindow
from output.lesion_button import LesionButton


class AIWorker(QThread):
    case_loaded = Signal(object)
    finished_ok = Signal(object)
    failed = Signal(str)

    def __init__(self, yunpacs_root):
        super().__init__()
        self.yunpacs_root = yunpacs_root
        self.controller = None

    def run(self):
        try:
            # 只有医生点击AI后，才导入并创建重型Runtime。
            from core.yunpacs_live_controller import (
                YUNPACSLiveController,
            )

            self.controller = YUNPACSLiveController(
                root=self.yunpacs_root
            )

            self.controller.poll_once()

            if self.controller.current_case is None:
                raise RuntimeError(
                    "没有读取到当前 YUNPACS 病例"
                )

            identity = self.controller.case_identity()

            if identity is None:
                raise RuntimeError(
                    "无法确认当前病例身份"
                )

            self.case_loaded.emit(identity)

        except Exception as e:
            self.failed.emit(
                f"{type(e).__name__}: {e}"
            )


class PhoenixMinimalWindow(QMainWindow):

    def __init__(self):
        super().__init__()

        self.setWindowTitle("Project Phoenix")
        self.resize(520, 230)

        yunpacs_root = os.environ.get(
            "PHOENIX_YUNPACS_ROOT",
            "D:/YUNPACS/放射诊断/ImageDir_r",
        )

        self.yunpacs_root = yunpacs_root
        self.live = None

        self.worker = None
        self.last_result = None
        self.report_window = None
        self.lesion_button = LesionButton()

        root_widget = QWidget()
        self.setCentralWidget(root_widget)

        root = QVBoxLayout(root_widget)

        title = QLabel("Project Phoenix")
        title.setStyleSheet(
            "font-size: 22px;"
            "font-weight: 600;"
            "padding: 12px;"
        )
        root.addWidget(title)

        self.case_label = QLabel(
            "当前病例：等待 YUNPACS 病例"
        )
        root.addWidget(self.case_label)

        self.status_label = QLabel(
            "状态：等待医生操作"
        )
        root.addWidget(self.status_label)

        buttons = QHBoxLayout()

        self.ai_button = QPushButton(
            "AI识别病灶"
        )

        self.report_button = QPushButton(
            "AI报告"
        )

        self.ai_button.setMinimumHeight(48)
        self.report_button.setMinimumHeight(48)

        buttons.addWidget(self.ai_button)
        buttons.addWidget(self.report_button)

        root.addLayout(buttons)

        self.ai_button.clicked.connect(
            self.start_ai
        )

        self.report_button.clicked.connect(
            self.show_report
        )

    def start_ai(self):
        if (
            self.worker is not None
            and self.worker.isRunning()
        ):
            return

        # 已经确认病例后，第二次点击才真正运行AI。
        if (
            self.live is not None
            and self.live.current_case is not None
        ):
            self.ai_button.setEnabled(False)

            self.status_label.setText(
                "状态：AI正在分析..."
            )

            try:
                result = self.live.analyze_current()
                self._analysis_finished(result)

                self.ai_button.setText(
                    "AI识别病灶"
                )

            except Exception as e:
                self._analysis_failed(
                    f"{type(e).__name__}: {e}"
                )

            return

        self.ai_button.setEnabled(False)
        self.status_label.setText(
            "状态：正在读取病例并进行AI分析..."
        )

        self.worker = AIWorker(self.yunpacs_root)

        self.worker.case_loaded.connect(
            self._case_loaded
        )

        self.worker.finished_ok.connect(
            self._analysis_finished
        )

        self.worker.failed.connect(
            self._analysis_failed
        )

        self.worker.finished.connect(
            lambda: self.ai_button.setEnabled(True)
        )

        self.worker.start()

    def _case_loaded(self, identity):
        case_id = identity.get("case_id") or "未知"
        uid = identity.get("study_uid") or "未知"

        modalities = ",".join(
            identity.get("modalities") or []
        )

        series_count = identity.get(
            "series_count",
            0,
        )

        file_count = identity.get(
            "file_count",
            0,
        )

        path = identity.get("path") or ""

        self.case_label.setText(
            f"当前病例：{case_id} | "
            f"{modalities} | "
            f"{series_count}序列 / "
            f"{file_count}文件"
        )

        self.case_label.setToolTip(
            f"StudyUID: {uid}\n"
            f"路径: {path}"
        )

        self.status_label.setText(
            "状态：请核对病例，确认无误后再次点击AI"
        )

        self.ai_button.setText(
            "确认病例并开始AI"
        )

        self.live = self.worker.controller


    def _analysis_finished(self, result):
        self.last_result = result
        self.live = self.worker.controller

        self.ai_button.setEnabled(True)
        self.case_label.setText(
            "当前病例：已载入"
        )
        self.status_label.setText(
            "状态：AI分析完成"
        )

        # 病灶截图/指向仍使用现有 RAM-only 结果。
        try:
            memory = self.live.runtime.memory

            if (
                memory is not None
                and getattr(memory, "images", None)
            ):
                self.lesion_button.start(
                    memory
                )
        except Exception:
            pass

    def _analysis_failed(self, error):
        self.ai_button.setEnabled(True)

        self.status_label.setText(
            "状态：AI分析失败"
        )

        QMessageBox.warning(
            self,
            "Phoenix",
            error,
        )

    def _report_text(self):
        result = self.last_result

        if result is None:
            return ""

        if isinstance(result, dict):
            analysis = result.get("analysis")

            if isinstance(analysis, dict):
                text = analysis.get(
                    "report_draft"
                )
            else:
                text = getattr(
                    analysis,
                    "report_draft",
                    None,
                )

            if text:
                return str(text)

            text = result.get("report_draft")
            if text:
                return str(text)

        return ""

    def show_report(self):
        text = self._report_text()

        if not text:
            QMessageBox.information(
                self,
                "Phoenix AI报告",
                "当前还没有AI报告，请先点击“AI识别病灶”。",
            )
            return

        if self.report_window is None:
            self.report_window = AIReportWindow(
                parent=self
            )

        self.report_window.set_report(text)
        self.report_window.show()
        self.report_window.raise_()
        self.report_window.activateWindow()

    def closeEvent(self, event):
        if (
            self.worker is not None
            and self.worker.isRunning()
        ):
            QMessageBox.information(
                self,
                "Phoenix",
                "AI正在分析，请等待当前分析完成后关闭。",
            )
            event.ignore()
            return

        try:
            self.lesion_button.close()
        except Exception:
            pass

        try:
            if self.live is not None:
                self.live.shutdown()
        except Exception:
            pass

        event.accept()
